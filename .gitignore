# Секреты и переменные окружения
.env
.env.*

# Виртуальные окружения (твоя локальная среда)
venv/
.venv/
env/
ENV/

# Кэш интерпретатора Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Файлы дистрибутивов и сборки
dist/
build/
*.egg-info
*.egg

# IDE и редакторы кода (если пользуешься)
.idea/
.vscode/
*.swp
*.swo

# Системные файлы ОС
.DS_Store
Thumbs.db

# Логи и временные файлы (если создаёшь)
logs/
*.log
tmp/
